# LearnPilot production environment - template only; never commit real values.
# Install: sudo install -o root -g root -m 0600 deploy/learnpilot.env.example /etc/learnpilot/learnpilot.env
# Startup (web.wsgi) refuses to run until every required value below is valid.

# Required secrets. Generate the key with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Passwords: at least 12 characters, different from each other, never the
# local-only development values.
DZI_SECRET_KEY=
DZI_ADMIN_PASSWORD=
DZI_TESTER_PASSWORD=

# Required state paths: absolute, outside /opt/learnpilot/app, writable by the
# learnpilot user. Browsing and quizzes both use DZI_DB.
DZI_DB=/var/lib/learnpilot/data/questions.db
DZI_UPLOAD_ROOT=/var/lib/learnpilot/uploads/practical
DZI_VAULT=/var/lib/learnpilot/vault
DZI_PUBLIC_HOST=

# Optional, read-only: official DZI reference resources for practical-task
# downloads, kept outside the checkout. Stored data/reference/... paths resolve
# here. Must be an existing directory when set. It is not part of the
# application snapshot; see docs/DEPLOYMENT.md (Backup, Restore).
DZI_REFERENCE_ROOT=/var/lib/learnpilot/data/reference

# Admin TOTP encryption key (Accounts PR T). Required before any admin account can
# sign in: admin sign-in fails closed without it, and startup rejects a malformed
# value. Generate once and keep it stable and backed up separately from database
# backups (losing it means re-enrolling every admin with manage_accounts totp-reset):
#   python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
DZI_TOTP_KEY=

# Optional public footer link.
# DZI_SOURCE_URL=

# Do not set FLASK_DEBUG, and do not set DZI_SESSION_COOKIE_SECURE to a false
# value: production cookies are HTTPS-only and startup rejects both.
