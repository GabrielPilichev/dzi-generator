# LearnPilot production environment - template only; never commit real values.
# Install: sudo install -o root -g root -m 0600 deploy/learnpilot.env.example /etc/learnpilot/learnpilot.env
# Startup (web.wsgi) refuses to run until every required value below is valid.

# Required secret. Generate the key with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
DZI_SECRET_KEY=

# Sign-in is by account only; accounts are managed with
# python3 -m src.manage_accounts. There is no shared password to configure.
# See docs/DEPLOYMENT.md, section 23.

# Required state paths: absolute, outside /opt/learnpilot/app, writable by the
# learnpilot user. Browsing and quizzes both use DZI_DB.
DZI_DB=/var/lib/learnpilot/data/questions.db
DZI_UPLOAD_ROOT=/var/lib/learnpilot/uploads/practical
DZI_VAULT=/var/lib/learnpilot/vault
DZI_PUBLIC_HOST=

# Optional, read-only: official DZI reference resources for practical-task
# downloads, kept outside the checkout. Stored data/reference/... paths resolve
# here. Must be an existing directory when set. It is not part of the
# application snapshot; see docs/DEPLOYMENT.md (Backup, Restore).
DZI_REFERENCE_ROOT=/var/lib/learnpilot/data/reference

# Admin TOTP encryption key (Accounts PR T). Set it before enrolling any admin.
# Normal TOTP verification needs it and fails closed (503) without it or with the
# wrong key. Recovery codes do not need it, so they remain the temporary recovery
# path if the key is lost; restore the correct key, or run manage_accounts
# totp-reset and re-enrol. Startup only rejects a malformed configured value.
# Generate once and keep it stable and backed up separately from database backups:
#   python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
DZI_TOTP_KEY=

# Google sign-in (optional; docs/DEPLOYMENT.md, section 29). Leave both lines
# commented out: this build keeps Google sign-in disabled in production whatever
# they hold, and only logs a warning when either is set. In a later build that
# enables it, both must be set together (startup then rejects one without the
# other or a malformed value), and removing both and restarting is the off switch.
# The callback address is always https://DZI_PUBLIC_HOST/auth/google/callback.
# The secret is never typed on a command line or stored in the repository.
# DZI_GOOGLE_CLIENT_ID=
# DZI_GOOGLE_CLIENT_SECRET=

# Student links and their QR codes are always built on https://DZI_PUBLIC_HOST.
# Do not set DZI_PUBLIC_BASE_URL here: it is a development-only override and
# startup rejects it. See docs/DEPLOYMENT.md, section 25.

# Optional public footer link.
# DZI_SOURCE_URL=

# Do not set FLASK_DEBUG, and do not set DZI_SESSION_COOKIE_SECURE to a false
# value: production cookies are HTTPS-only and startup rejects both.
