# LearnPilot online SQLite backup - template; see docs/DEPLOYMENT.md (Backup).
# Runs as the service user against the live database; safe while the app runs.

[Unit]
Description=LearnPilot application snapshot (SQLite, uploads, generated vault)
After=learnpilot.service
# No snapshot of a partly replaced state (the tool refuses as well).
ConditionPathExists=!/var/lib/learnpilot/data/restore-in-progress

[Service]
Type=oneshot
User=learnpilot
Group=learnpilot
WorkingDirectory=/opt/learnpilot/app
EnvironmentFile=/etc/learnpilot/backup.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/learnpilot/venv/bin/python -m src.backup_application --db ${DZI_DB} --uploads ${DZI_UPLOAD_ROOT} --vault ${DZI_VAULT} --output-dir /var/backups/learnpilot

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The live DB directory must be writable for SQLite WAL/SHM handling.
ReadWritePaths=/var/lib/learnpilot /var/backups/learnpilot
UMask=0077
