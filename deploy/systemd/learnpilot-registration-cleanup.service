# LearnPilot registration cleanup - template; see docs/DEPLOYMENT.md, section 34.
# Expires and scrubs overdue pending registrations and deletes old final and ledger rows
# (docs/reviews/EMAIL_REGISTRATION_DESIGN.md, 6.5). Logical retention only: it erases nothing
# physically. Runs as the service user against the live database; safe while the app runs.
# Needs no secret: the settings file is the backup unit's, which holds the state paths only.

[Unit]
Description=LearnPilot registration cleanup (expire and scrub unverified registrations)
# Not while a restore is in progress or was left unfinished (the command refuses as well,
# and deploy/learnpilot-restore.sh also requires this unit to be inactive or failed).
ConditionPathExists=!/var/lib/learnpilot/data/restore-in-progress

[Service]
# A oneshot unit is never started a second time while it is running: a timer firing during a
# long run does nothing. A failed run (database busy, clock behind the mark) leaves the unit
# "failed" for the health check and is not retried before the next tick.
Type=oneshot
User=learnpilot
Group=learnpilot
WorkingDirectory=/opt/learnpilot/app
EnvironmentFile=/etc/learnpilot/backup.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/learnpilot/venv/bin/python -m src.manage_accounts --db ${DZI_DB} registrations-cleanup
TimeoutStartSec=5min

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# The live DB directory must be writable for SQLite WAL/SHM handling.
ReadWritePaths=/var/lib/learnpilot
UMask=0027
